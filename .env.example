# YolUp landing — sozlanadigan manzillar.
#
# Bu faylni `.env.local` ga nusxalang va qiymatlarni to'ldiring.
# Hech biri majburiy emas: ko'rsatilmasa, `src/content/site.ts` dagi
# standart qiymatlar ishlatiladi.

# Kanonik manzil (canonical, Open Graph va JSON-LD shu yerdan quriladi).
NEXT_PUBLIC_SITE_URL=https://yolup.uz

# Asosiy CTA — platforma ishga tushmaguncha shu yerga olib boradi.
# TEKSHIRILISHI KERAK: standart qiymat avvalgi landing'dan meros.
# Agar kanal hali yo'q bo'lsa, BO'SH qoldiring — shunda sahifada havola
# o'rniga "Manzil hali sozlanmagan" tugmasi chiqadi.
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/yolup_uz

# Faqat `IS_LIVE = true` bo'lganda ishlatiladi (`src/content/site.ts`).
NEXT_PUBLIC_REGISTER_URL=/register
NEXT_PUBLIC_LOGIN_URL=/login
